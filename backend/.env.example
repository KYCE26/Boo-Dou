PORT=8080

# Free tier Geraikita (Bansos) untuk testing. Untuk pindah ke paket berbayar
# atau provider lain yang OpenAI-compatible, cukup ganti ketiga variabel LLM_.
# Model Bansos: deepseek-v4-flash, glm-5.3-flash, qwen3.8-flash, qwen3.8-max.
LLM_BASE_URL=https://ai.geraikita.com/v1/claude
LLM_API_KEY=
LLM_MODEL=qwen3.8-max

# Opsional. Kapan kuota harian provider direset, ditampilkan di pesan error 429.
# Kosongkan kalau provider tidak punya kuota harian.
LLM_QUOTA_RESET=tengah malam WIB

CORS_ORIGIN=http://localhost:5173

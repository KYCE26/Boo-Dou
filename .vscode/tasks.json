{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: air",
      "type": "shell",
      "command": "air",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "go",
        "fileLocation": ["relative", "${workspaceFolder}/backend"],
        "pattern": { "regexp": "^(.+\\.go):(\\d+):(\\d+): (.+)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": { "activesBegins": ".", "beginsPattern": "building", "endsPattern": "running|jalan di" }
      },
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": { "activesBegins": ".", "beginsPattern": "VITE", "endsPattern": "Local:" }
      },
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "dev: semua",
      "dependsOn": ["backend: air", "frontend: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "backend: vet + build",
      "type": "shell",
      "command": "go vet ./... && go build ./...",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build",
      "problemMatcher": ["$go"]
    }
  ]
}

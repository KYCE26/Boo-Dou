{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: debug (Delve)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/server",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend: debug Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Backend: debug (Delve)", "Frontend: debug Chrome"],
      "stopAll": true
    }
  ]
}
